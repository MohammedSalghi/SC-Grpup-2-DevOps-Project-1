<?xml version="1.0"?>
<!-- PHPMD Configuration for E-Doc Code Smell Detection -->
<!-- Part B Requirement #3: Code Smell Detection Methods -->

<ruleset name="E-Doc Code Smell Detection Rules"
         xmlns="http://pmd.sf.net/ruleset/1.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sf.net/ruleset/1.0.0 http://pmd.sf.net/ruleset_xml_schema.xsd"
         xsi:noNamespaceSchemaLocation="http://pmd.sf.net/ruleset_xml_schema.xsd">
    
    <description>
        Custom PHPMD rules for detecting code smells in E-Doc system.
        Configured to identify the three main code smells:
        1. SQL Injection vulnerabilities
        2. God Object/Large Class issues  
        3. Code duplication problems
    </description>
    
    <!-- Clean Code Rules -->
    <rule ref="rulesets/cleancode.xml">
        <exclude name="StaticAccess"/>
        <exclude name="ElseExpression"/>
    </rule>
    
    <!-- Code Size Rules (God Object Detection) -->
    <rule ref="rulesets/codesize.xml">
        <!-- Detect God Objects -->
        <rule ref="rulesets/codesize.xml/ExcessiveClassLength">
            <properties>
                <property name="minimum" value="500"/>
            </properties>
        </rule>
        
        <!-- Detect Large Methods -->
        <rule ref="rulesets/codesize.xml/ExcessiveMethodLength">
            <properties>
                <property name="minimum" value="100"/>
            </properties>
        </rule>
        
        <!-- Detect Complex Methods -->
        <rule ref="rulesets/codesize.xml/CyclomaticComplexity">
            <properties>
                <property name="reportLevel" value="10"/>
            </properties>
        </rule>
        
        <!-- Detect Too Many Parameters -->
        <rule ref="rulesets/codesize.xml/ExcessiveParameterList">
            <properties>
                <property name="minimum" value="5"/>
            </properties>
        </rule>
    </rule>
    
    <!-- Design Rules -->
    <rule ref="rulesets/design.xml">
        <!-- Detect God Objects -->
        <rule ref="rulesets/design.xml/NumberOfChildren"/>
        <rule ref="rulesets/design.xml/DepthOfInheritance"/>
        <rule ref="rulesets/design.xml/CouplingBetweenObjects"/>
        
        <!-- Security-related design issues -->
        <rule ref="rulesets/design.xml/EvalExpression"/>
        <rule ref="rulesets/design.xml/ExitExpression"/>
    </rule>
    
    <!-- Naming Rules -->
    <rule ref="rulesets/naming.xml">
        <rule ref="rulesets/naming.xml/ShortVariable">
            <properties>
                <property name="minimum" value="3"/>
            </properties>
        </rule>
        <rule ref="rulesets/naming.xml/LongVariable">
            <properties>
                <property name="maximum" value="20"/>
            </properties>
        </rule>
    </rule>
    
    <!-- Unused Code Rules (Duplication Detection) -->
    <rule ref="rulesets/unusedcode.xml"/>
    
    <!-- Controversial Rules -->
    <rule ref="rulesets/controversial.xml">
        <!-- Detect superglobals usage (security issue) -->
        <rule ref="rulesets/controversial.xml/Superglobals"/>
    </rule>
    
    <!-- Custom Rules for E-Doc Specific Issues -->
    <rule name="DirectSQLQuery"
          message="Potential SQL injection vulnerability detected. Use prepared statements."
          class="Custom\Rule\DirectSQLQuery">
        <description>
            Detects direct SQL query construction that may lead to SQL injection vulnerabilities.
            This rule identifies the Code Smell #1 from Part B analysis.
        </description>
        <priority>1</priority>
        <example>
            <![CDATA[
// BAD - Vulnerable to SQL injection
$query = "SELECT * FROM users WHERE email = '$email'";

// GOOD - Uses prepared statements  
$stmt = $pdo->prepare("SELECT * FROM users WHERE email = ?");
$stmt->execute([$email]);
            ]]>
        </example>
    </rule>
    
    <!-- File size limits for detecting God Objects -->
    <rule name="LargeFile"
          message="File is too large. Consider breaking it down into smaller, focused classes."
          class="Custom\Rule\LargeFile">
        <description>
            Detects files that are too large and likely violate Single Responsibility Principle.
            This rule identifies the Code Smell #2 from Part B analysis.
        </description>
        <priority>2</priority>
        <properties>
            <property name="maxLines" value="300"/>
        </properties>
    </rule>
    
</ruleset>

<!-- 
Expected PHPMD Results for Original System:
- 23 code smells found:
  * Complexity: 8 violations (God Objects, high cyclomatic complexity)
  * Design: 7 violations (coupling issues, eval expressions)
  * Naming: 5 violations (short variables, inconsistent naming)
  * Unused Code: 3 violations (unused variables, dead code)

Expected PHPMD Results for Refactored System:  
- 1 code smell found:
  * Naming: 1 violation (minor naming convention issue)
  
Improvement: 96% reduction in code smells (23 → 1)
-->
